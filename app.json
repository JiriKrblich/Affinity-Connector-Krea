{
  "id": "krea",
  "name": "Krea",
  "description": "Generate images, or transform what is on the canvas, using Krea's models. The result lands back in your document.",
  "version": "1.5.11",
  "testedWith": "Affinity 3.2.3 · Connector for Affinity 1.0.0",
  "author": "jirikrblich",
  "bar": { "icon": "sparkles" },
  "url": "https://jirikrblich.netlify.app",
  "image": "docs/Header.jpg",
  "runLabel": "Generate",
  "main": "index.js",
  "secrets": [
    {
      "key": "KREA_API_KEY",
      "label": "Krea API key",
      "help": "Create one at krea.ai under Settings, API tokens. It is stored outside this app's folder."
    }
  ],
  "fields": [
    {
      "key": "model",
      "type": "select",
      "label": "Model",
      "optionsFrom": "models",
      "default": "krea/krea-2/large",
      "options": [
        {
          "value": "krea/krea-2/large",
          "label": "Krea 2 Large"
        },
        {
          "value": "krea/krea-2/medium",
          "label": "Krea 2 Medium"
        },
        {
          "value": "krea/krea-2/medium-turbo",
          "label": "Krea 2 Medium Turbo"
        },
        {
          "value": "google/nano-banana-pro",
          "label": "Nano Banana Pro"
        },
        {
          "value": "google/nano-banana",
          "label": "Nano Banana"
        },
        {
          "value": "google/nano-banana-2",
          "label": "Nano Banana 2"
        },
        {
          "value": "z-image/z-image",
          "label": "Z Image"
        },
        {
          "value": "bytedance/seedream-5-pro",
          "label": "Seedream 5 Pro"
        },
        {
          "value": "bytedance/seedream-5-lite",
          "label": "Seedream 5 Lite"
        },
        {
          "value": "openai/gpt-image-2.5-flare",
          "label": "GPT Image 2.5 Flare"
        },
        {
          "value": "openai/gpt-image-2.5-sunburst",
          "label": "GPT Image 2.5 Sunburst"
        },
        {
          "value": "bfl/flux-1-kontext-dev",
          "label": "FLUX Kontext"
        },
        {
          "value": "bfl/flux-1.1-pro",
          "label": "FLUX 1.1 Pro"
        },
        {
          "value": "openai/gpt-image",
          "label": "ChatGPT Image"
        }
      ],
      "help": "Krea's own models need a size on the end of the name. Press refresh to pull what your account can reach."
    },
    {
      "key": "prompt",
      "type": "textarea",
      "label": "Prompt",
      "placeholder": "A cinematic product photo of a glass lamp on a marble table",
      "required": true
    },
    {
      "key": "image",
      "type": "image",
      "label": "Start from",
      "source": "none",
      "sources": [
        "none",
        "selection",
        "lasso",
        "area",
        "native",
        "artboard",
        "layer",
        "spread",
        "document",
        "file"
      ],
      "help": "Leave on Nothing to generate from the prompt alone. Anything else sends that artwork as the starting point."
    },
    {
      "key": "strength",
      "type": "slider",
      "label": "How far from the original",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.8,
      "showIf": [
        {
          "key": "image",
          "isEmpty": false
        },
        {
          "key": "model",
          "startsWith": "krea/"
        }
      ],
      "help": "Krea 2 only, and only when you start from artwork. Lower keeps more of what you sent.",
      "advanced": true
    },
    {
      "key": "aspect",
      "type": "select",
      "label": "Aspect ratio",
      "default": "1:1",
      "options": [
        "1:1",
        "4:3",
        "3:2",
        "16:9",
        "2.35:1",
        "4:5",
        "2:3",
        "9:16"
      ],
      "optionsFrom": "aspects",
      "dependsOn": "model",
      "help": "The list follows the model you picked."
    },
    {
      "key": "resolution",
      "type": "select",
      "label": "Resolution",
      "default": "1K",
      "options": [
        "1K",
        "2K",
        "4K"
      ],
      "help": "Not every model offers every size. A size the chosen model cannot make is ignored and its safe default is used.",
      "advanced": true
    },
    {
      "key": "place",
      "type": "checkbox",
      "label": "Place the result in the document when it arrives",
      "default": true,
      "advanced": true
    }
  ]
}
